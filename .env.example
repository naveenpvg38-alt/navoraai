# ─────────────────────────────────────────
#  NAVORA AI — Environment Variables
# ─────────────────────────────────────────

# ── Frontend (Vercel) ──────────────────
# Set this in Vercel Dashboard → Project → Settings → Environment Variables
# Point to your Render.com backend URL (e.g. https://navora-ai-backend.onrender.com/api)
VITE_API_URL=

# ── Backend (Render.com) ───────────────
# These are set automatically by render.yaml or manually in Render dashboard
PORT=5000
JWT_SECRET=your_secret_key_here
NODE_ENV=production
